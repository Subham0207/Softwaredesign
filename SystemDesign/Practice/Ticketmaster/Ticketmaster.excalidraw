    {
      "id": "tGxMU3AKN5YZ2P0sAWlhq",
      "type": "text",
      "x": 396.34375,
      "y": 123.5078125,
      "width": 854.7994995117188,
      "height": 3575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
