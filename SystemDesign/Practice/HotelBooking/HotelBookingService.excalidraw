    {
      "id": "AhZM6E5X3NdVQZpIb1DVk",
      "type": "text",
      "x": 3394.0075169355573,
      "y": 44.852686069072874,
      "width": 301.37982177734375,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1f",
      "roundness": null,
      "seed": 1379449371,
      "version": 1088,
      "versionNonce": 666537147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787048052336,
      "link": null,
      "locked": false,
      "text": "Select *, count(r.id) from Hotel\nLEFT JOIN ON Booking as b\nwhere desc like '%term%'\nand location = 'HYD'\n// rooms available \n\nand not exists\n(\nselect 1 from b where\nb.roomId = r.id\nAND b.status = 'BOOKED'\nstatus = BOOKED and\nb.startDate < req.endDate\nb.endDate > req.startDate\n)\n\norderby hotelid",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Select *, count(r.id) from Hotel\nLEFT JOIN ON Booking as b\nwhere desc like '%term%'\nand location = 'HYD'\n// rooms available \n\nand not exists\n(\nselect 1 from b where\nb.roomId = r.id\nAND b.status = 'BOOKED'\nstatus = BOOKED and\nb.startDate < req.endDate\nb.endDate > req.startDate\n)\n\norderby hotelid",
      "autoResize": true,
      "lineHeight": 1.25
    },
