      "version": 648,
      "versionNonce": 2090548245,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787046625426,
      "link": null,
      "locked": false,
      "text": "API Design\n\n- Search hotel: /search?term={hotel with pool}&&location={HYD}&&HotelName={Marriot} - Paritial<Hotel>[]\n- search by hotelId: /Hotel/:hotelId -> Hotel\n{\n     rooms available: Room[],\n     no. of rooms: number\n}\n\n- Booking - /book/reserve/ -> roomid, hotelid, startdate, enddate\n{\n    paymentdetails: {}\n}\n\n- /book/confirm/:bookingId",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Design\n\n- Search hotel: /search?term={hotel with pool}&&location={HYD}&&HotelName={Marriot} - Paritial<Hotel>[]\n- search by hotelId: /Hotel/:hotelId -> Hotel\n{\n     rooms available: Room[],\n     no. of rooms: number\n}\n\n- Booking - /book/reserve/ -> roomid, hotelid, startdate, enddate\n{\n    paymentdetails: {}\n}\n\n- /book/confirm/:bookingId",
      "autoResize": true,
      "lineHeight": 1.25
    },
