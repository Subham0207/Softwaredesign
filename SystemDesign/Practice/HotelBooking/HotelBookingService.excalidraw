      "text": "Entities:\n- User\n- Booking\n- Room\n- Hotel\n- Location",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entities:\n- User\n- Booking\n- Room\n- Hotel\n- Location",
